# LLM for the audit agent. Any OpenAI-compatible provider.
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o

# SPECULOS_URL=http://127.0.0.1:5001
# RPC_URL=https://sepolia.base.org
# USDC_PER_GBP=1.27
# MAX_CLAIM_GBP=100
# Set to false to stop after signing (no funds needed)
# BROADCAST=true

# 24-word seed for the emulated Ledger (npm run speculos reads it). It decides the treasury
# address. Leave unset to use Speculos' default seed, which is public. Testnet funds only.
# SPECULOS_SEED=

# Ledger Key Ring (optional, see README): `npm run keyring -- seal` moves LLM_API_KEY out of this
# file into secrets.enc. Defaults: Ledger's staging service, application 17, Sync emulator on 5002.
# KEYRING_API=https://trustchain-backend.api.aws.stg.ldg-tech.com
# KEYRING_APPLICATION_ID=17
# SYNC_SPECULOS_PORT=5002
