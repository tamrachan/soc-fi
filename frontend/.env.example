# "mock" (default, used for the GitHub Pages demo), "firebase", or "hybrid" (mock data, but
# payments are signed on the emulated Ledger through backend/ — run both, see backend/README.md)
VITE_DATA_SOURCE=mock
# Only used when VITE_DATA_SOURCE=hybrid
VITE_BACKEND_URL=http://localhost:3000

# Only needed when VITE_DATA_SOURCE=firebase. Copy to .env.local — never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
